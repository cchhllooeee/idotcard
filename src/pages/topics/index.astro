---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { published } from '@/lib/content';
import { graph, itemListNode, webPageNode } from '@/lib/seo';
import { url } from '@/lib/urls';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const articles = await published('articles');
const site = Astro.site!;
const path = url.topics();
const title = '信用卡主題列表：依需求找文章';
const description = '依現金回饋、海外消費、行動支付、新戶首刷等主題整理信用卡文章與推薦，快速找到符合需求的內容。';
const crumbs = [{ name: '首頁', href: '/' }, { name: '主題', href: path }];
const items = topics.map((t) => ({ name: t.data.name, href: url.topic(t.id) }));
const jsonLd = graph(site, [...webPageNode(site, { path, title, description, crumbs, type: 'CollectionPage' }), itemListNode(site, path, items)]);
---

<BaseLayout {title} {description} {path} {crumbs} {jsonLd}>
  <h1>信用卡主題</h1>
  <ul class="grid">
    {topics.map((t) => (
      <li>
        <a href={url.topic(t.id)}><strong>{t.data.name}</strong></a>
        <p class="muted small">{t.data.description}</p>
        <p class="muted small">{articles.filter((a) => a.data.primaryTopic.id === t.id).length} 篇文章</p>
      </li>
    ))}
  </ul>
</BaseLayout>
