---
import { getEntries, getEntry, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { mdxComponents } from '@/components/content/mdx';
import { displayDate, published } from '@/lib/content';
import { articleNode, faqNode, graph, personNode, webPageNode } from '@/lib/seo';
import { url } from '@/lib/urls';

export async function getStaticPaths() {
  const news = await published('news');
  return news.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const site = Astro.site!;
const path = url.news(item.id);
const { Content, headings } = await render(item);
const cards = await getEntries(d.cards);
const author = (await getEntry('authors', d.author.id))!;
const reviewer = d.reviewer ? await getEntry('authors', d.reviewer.id) : undefined;
const crumbs = [{ name: '首頁', href: '/' }, { name: '權益快訊', href: url.newsIndex() }, { name: d.title, href: path }];
const jsonLd = graph(site, [
  ...webPageNode(site, { path, title: d.title, description: d.description, crumbs, datePublished: d.publishedAt, dateModified: d.updatedAt, reviewer }),
  articleNode(site, {
    path, type: 'NewsArticle', title: d.title, description: d.description, datePublished: d.publishedAt, dateModified: d.updatedAt, author,
    about: cards.map((c) => ({ name: c.data.name, href: url.card(c.id), kind: 'card' as const })),
    citations: d.sources.map((s) => s.url),
  }),
  personNode(site, author),
  reviewer && personNode(site, reviewer),
  faqNode(site, path, d.faq),
]);
---

<ArticleLayout {path} {crumbs} {jsonLd} {headings} data={d} {cards} eyebrow={{ name: '權益快訊', href: url.newsIndex() }}>
  {d.effectiveDate && <p><strong>生效日：{displayDate(d.effectiveDate)}</strong></p>}
  <Content components={mdxComponents} />
  <Fragment slot="after">
    {cards.length > 0 && <p class="small">相關卡片：{cards.map((c) => <a class="badge" href={url.card(c.id)}>{c.data.name}</a>)}</p>}
  </Fragment>
</ArticleLayout>
