---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import CardSpecTable from '@/components/content/CardSpecTable.astro';
import { mdxComponents } from '@/components/content/mdx';
import { published } from '@/lib/content';
import { articleNode, faqNode, graph, itemListNode, personNode, webPageNode } from '@/lib/seo';
import { url } from '@/lib/urls';

export async function getStaticPaths() {
  const best = await published('best');
  return best.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const site = Astro.site!;
const path = url.best(item.id);
const { Content, headings } = await render(item);
const picks = await Promise.all(d.picks.map(async (p) => ({ ...p, entry: (await getEntry('cards', p.card.id))! })));
const topic = (await getEntry('topics', d.primaryTopic.id))!;
const author = (await getEntry('authors', d.author.id))!;
const reviewer = d.reviewer ? await getEntry('authors', d.reviewer.id) : undefined;
const crumbs = [{ name: '首頁', href: '/' }, { name: '推薦排行', href: url.bestIndex() }, { name: d.title, href: path }];
const jsonLd = graph(site, [
  ...webPageNode(site, { path, title: d.title, description: d.description, crumbs, datePublished: d.publishedAt, dateModified: d.updatedAt, reviewer }),
  articleNode(site, {
    path, title: d.title, description: d.description, datePublished: d.publishedAt, dateModified: d.updatedAt, author,
    about: picks.map((p) => ({ name: p.entry.data.name, href: url.card(p.entry.id), kind: 'card' as const })),
  }),
  itemListNode(site, path, picks.map((p) => ({ name: p.entry.data.name, href: url.card(p.entry.id) })), d.title),
  personNode(site, author),
  reviewer && personNode(site, reviewer),
  faqNode(site, path, d.faq),
]);
---

<ArticleLayout {path} {crumbs} {jsonLd} {headings} data={d} cards={picks.map((p) => p.entry)} eyebrow={{ name: `${topic.data.name}・推薦排行`, href: url.topic(topic.id) }} sponsored={picks.some((p) => p.entry.data.sponsored)}>
  <h2>推薦名單一覽</h2>
  <table>
    <thead><tr><th scope="col">排名</th><th scope="col">卡片</th><th scope="col">推薦原因</th></tr></thead>
    <tbody>{picks.map((p, i) => <tr><td>{i + 1}</td><td><a href={url.card(p.entry.id)}>{p.entry.data.name}</a><br /><span class="badge">{p.label}</span></td><td>{p.reason}</td></tr>)}</tbody>
  </table>
  <h2>評選標準</h2>
  <ul>{d.criteria.map((c) => <li>{c}</li>)}</ul>
  {picks.map((p, i) => (
    <section>
      <h2>{i + 1}. {p.entry.data.name}：{p.label}</h2>
      <p>{p.reason}</p>
      <CardSpecTable card={p.entry} showMerchants={false} />
    </section>
  ))}
  <Content components={mdxComponents} />
  <Fragment slot="after"><p class="small">主題：<a href={url.topic(topic.id)}>{topic.data.name}</a></p></Fragment>
</ArticleLayout>
