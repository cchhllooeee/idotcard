---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Summary from '@/components/content/Summary.astro';
import LinkList from '@/components/layout/LinkList.astro';
import { displayDate, isRewardActive, latest, mentionsOf } from '@/lib/content';
import { articleNode, graph, itemListNode, webPageNode } from '@/lib/seo';
import { url } from '@/lib/urls';

export async function getStaticPaths() {
  const merchants = await getCollection('merchants');
  return merchants.map((merchant) => ({ params: { id: merchant.id }, props: { merchant } }));
}

const { merchant } = Astro.props;
const d = merchant.data;
const site = Astro.site!;
const path = url.merchant(merchant.id);
const cards = await getCollection('cards', (c) => c.data.status === 'active');
// 依通路回饋率排序：通路專屬回饋優先，沒有時不列入
const rows = cards
  .flatMap((c) => c.data.merchantRewards.filter((m) => m.merchant.id === merchant.id && isRewardActive(m)).map((m) => ({ card: c, ...m })))
  .sort((a, b) => b.ratePercent - a.ratePercent);
const updatedAt = latest(d.updatedAt, ...rows.map((r) => r.card.data.updatedAt));
const top = rows[0];
const summary = top
  ? `在${d.name}消費，目前回饋最高的是${top.card.data.name}（${top.ratePercent}%${top.capPerMonth !== undefined ? `，每月上限 ${top.capPerMonth} 元` : ''}）。`
  : `目前資料庫中沒有針對${d.name}的專屬回饋卡，建議使用一般消費回饋較高的卡。`;
const mentions = await mentionsOf({ collection: 'merchants', id: merchant.id });
const crumbs = [{ name: '首頁', href: '/' }, { name: '通路', href: url.merchants() }, { name: d.name, href: path }];
const title = `${d.name}刷什麼卡？信用卡回饋排行`;
const description = `${summary}整理${d.name}各信用卡的回饋率、上限與條件，資料每次銀行公告更新時同步調整。`.slice(0, 155);
const jsonLd = graph(site, [
  ...webPageNode(site, { path, title, description, crumbs, dateModified: updatedAt }),
  articleNode(site, { path, title, description, datePublished: d.updatedAt, dateModified: updatedAt }),
  itemListNode(site, path, rows.map((r) => ({ name: r.card.data.name, href: url.card(r.card.id) })), `${d.name}信用卡回饋排行`),
]);
---

<BaseLayout {title} {description} {path} {crumbs} {jsonLd} {updatedAt} ogType="article" searchable>
  <h1>{d.name}刷什麼卡最划算？</h1>
  <Summary text={summary} />
  <p class="muted small">更新日期 {displayDate(updatedAt)}｜{d.description}</p>
  <h2>{d.name}信用卡回饋排行</h2>
  {rows.length > 0 ? (
    <table>
      <thead><tr><th scope="col">卡片</th><th scope="col">回饋率</th><th scope="col">每月上限</th><th scope="col">條件</th></tr></thead>
      <tbody>{rows.map((r) => (
        <tr><td><a href={url.card(r.card.id)}>{r.card.data.name}</a></td><td>{r.ratePercent}%</td><td>{r.capPerMonth !== undefined ? `${r.capPerMonth} 元` : '無上限'}</td><td>{r.note ?? '—'}</td></tr>
      ))}</tbody>
    </table>
  ) : <p class="muted">目前沒有通路專屬回饋資料。</p>}
  {mentions.length > 0 && (<><h2>相關文章</h2><LinkList items={mentions.map((m) => ({ href: m.href, title: m.title, badge: m.kind }))} /></>)}
</BaseLayout>
