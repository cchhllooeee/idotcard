---
interface Props { current: number; total: number; href: (page: number) => string }
const { current, total, href } = Astro.props;
---

{total > 1 && (
  <nav class="pagination" aria-label="分頁">
    {current > 1 && <a href={href(current - 1)} rel="prev">上一頁</a>}
    <span>第 {current} / {total} 頁</span>
    {current < total && <a href={href(current + 1)} rel="next">下一頁</a>}
  </nav>
)}
