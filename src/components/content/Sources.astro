---
import { displayDate } from '@/lib/content';
interface Props { sources: { title: string; url: string; checkedAt: Date }[] }
const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources">
    <h2>資料來源</h2>
    <ul>
      {sources.map((s) => (
        <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a> <span class="muted small">（核對日期 {displayDate(s.checkedAt)}）</span></li>
      ))}
    </ul>
  </section>
)}
