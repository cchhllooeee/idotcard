---
/** magazine 版頁首：品牌色橫條（Logo、搜尋、主選單）＋ 主題圖示分類列 */
import { getCollection } from 'astro:content';
import TopicIcon from './TopicIcon.astro';
import { SITE } from '@/lib/site';
import { url } from '@/lib/urls';
interface Props { current?: string }
const { current } = Astro.props;
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const main = [
  { href: url.cards(), label: '信用卡' },
  { href: url.bestIndex(), label: '推薦排行' },
  { href: url.offers(), label: '優惠情報' },
  { href: url.newsIndex(), label: '權益快訊' },
  { href: url.tools(), label: '試算工具' },
];
---

<header class="mz-header" data-pagefind-ignore>
  <div class="mz-bar">
    <div class="mz-wrap mz-bar-inner">
      <a class="mz-logo" href="/" aria-label={`${SITE.name} 首頁`}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#fff"/><rect x="6" y="10" width="20" height="13" rx="2.5" fill="none" stroke="var(--mz-brand)" stroke-width="2"/><path d="M6 14.5h20" stroke="var(--mz-brand)" stroke-width="2"/></svg>
        <span>{SITE.name}</span>
      </a>
      <nav class="mz-main" aria-label="主選單">
        <ul>{main.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
      </nav>
      <form class="mz-search" action="/search/" method="get" role="search">
        <label class="sr-only" for="mz-q">搜尋</label>
        <input id="mz-q" name="q" type="search" placeholder="搜尋卡片、銀行、問題…" />
      </form>
    </div>
  </div>
  <nav class="mz-cats" aria-label="主題分類">
    <ul class="mz-wrap">
      {topics.map((t) => (
        <li><a href={url.topic(t.id)} aria-current={current === t.id ? 'page' : undefined}><TopicIcon id={t.id} size={22} /><span>{t.data.name}</span></a></li>
      ))}
    </ul>
  </nav>
</header>
