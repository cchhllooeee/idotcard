{
  "name": "idotcard",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/check-site.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "dev:magazine": "SITE_VARIANT=magazine astro dev --port 4322",
    "build:magazine": "SITE_VARIANT=magazine astro build && pagefind --site dist-magazine && SITE_DIST=dist-magazine node scripts/check-site.mjs",
    "preview:magazine": "python3 -m http.server 4322 --directory dist-magazine",
    "preview:pages": "python3 -m http.server 4330 --directory .pages-sim"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3"
  }
}
